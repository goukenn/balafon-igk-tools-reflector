    $regex->append($regex->createPattern(['patterns'=>$comments]));
    // $ns = $regex->match('namespace\\b\\s*([a-zA-Z_][a-zA-Z_]*(?:\\\\[a-zA-Z_][a-zA-Z_]*)*)\\s*;', 'namespace')->last();
    
