    // $gdc_func_detector = $regex->match('\\b(function)\\b(?:\\s*&\\s*)?', 'gdc-function')->last();
    $gdc_func_end_instruct = $regex->match(';', 'gdc-end-instruct')->last();
    // $gdc_litteral = $regex->match('\\b([a-zA-Z_][a-zA-Z_]*)\\b', 'gdc-litteral')->last();
    $gdc_return_type = $regex->begin(':', '(?=\{|;)', 'gdc-return-type')->last();
    $regex->match('\\$([a-zA-Z_][a-zA-Z_]*)\\b', 'gdc-variable');
    $gdc_cond = $regex->begin('\(', '\)', 'gdc-cond')->last();
    $gdc_cond->patterns = [
        $comments,
        $string,
        $array,
        ['patterns' => $here_doc],
        $gdc_cond
    ];
    $gdc_child_block_curl_brank = $regex->createPattern(['begin' => '\{', 'end' => '\}', 'tokenID' => 'condition-sub-curl_brank']);
    $gdc_child_block_curl_brank->patterns = [
        ['patterns' => $comments],
        $string,
        $gdc_child_block_curl_brank
    ];
    $curl_brank->patterns = [
        ['patterns' => $comments],
        $gdc_func_detector,
        $gdc_func_end_instruct,
        $gdc_litteral,
        $gdc_return_type,
        $cond,
        $gdc_child_block_curl_brank
    ];


    $g->patterns = [
        $implements,
        $extends,
        $type_litteral,
        $litteral,
        $body_brank
    ];
    $global_use = $regex->begin('\\buse\\b', ';', 'global-use')->last();
    // namespace block
    $block_pattern[] = $global_use;
    $block_pattern[] = $modifier;
