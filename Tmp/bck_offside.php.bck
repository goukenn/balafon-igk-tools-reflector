    $cond->patterns = [
        $comment,
        $string,
        $array,
        $cond
    ];
    $array->patterns = [
        $comment,
        $string,
        $array
    ];
    $func_return_type->patterns = [
        $comment,
        $multiline_comment,
        $string
    ];
